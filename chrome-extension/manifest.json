{
  "manifest_version": 3,
  "name": "halfbold",
  "version": "0.5.0",
  "description": "Convert each website's own fonts into half-bold reading fonts",
  "permissions": [
    "alarms",
    "fontSettings",
    "storage",
    "nativeMessaging",
    "scripting"
  ],
  "background": {
    "service_worker": "autoreload.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "pagefonts-core.js",
        "limited-body.js",
        "pagefonts.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "fonts/*.ttf"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "key": "",
  "host_permissions": [
    "<all_urls>"
  ]
}
