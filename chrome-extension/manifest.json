{
  "manifest_version": 3,
  "name": "halfbold",
  "version": "0.3.0",
  "description": "Render every website in a locally installed half-bold reading font",
  "permissions": ["alarms", "storage"],
  "background": {
    "service_worker": "autoreload.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "css": ["halfbold.css"],
      "js": ["shadow.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["halfbold.css"],
      "matches": ["<all_urls>"]
    }
  ]
}
